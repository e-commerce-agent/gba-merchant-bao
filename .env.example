# 复制为仓库根 .env，填写密码；本文件不供 IDEA 读取。
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
MYSQL_DATABASE=gba_dev
MYSQL_USER=dev_admin
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
MYSQL_PORT=3307
REDIS_PORT=6380
# dev Redis 无密码，不添加 REDIS_PASSWORD。
# SOAP WebService 服务间凭证（物流模块独立信任域；不配置时 SOAP 查询全部拒绝）。
SHIPMENT_WS_TOKEN=REPLACE_WITH_LOCAL_SHIPMENT_WS_TOKEN
