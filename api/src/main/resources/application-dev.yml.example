spring:
  flyway:
    locations: classpath:db/migration,classpath:db/seed/common,classpath:db/seed/nonprod,classpath:db/devdata

merchant:
  agent:
    # dots Chat Completions；填入本机 API key 后启用/启动。
    enabled: false
    base-url: https://note3-prev-api.askdiandian.com/v1
    api-key: ""
    api-key-header: api-key
    model: dots3-note-prev
    service-label: dots
    # dots 默认开启深度思考，为首个正文 token 留出时间。
    first-token-timeout: 90s
    total-timeout: 180s

  # ── RAG 知识库 ─────────────────────────────────────────────
    # 默认关闭：关闭时不校验下面任何配置，也不要求 Milvus 启动。
    # 启用前请先填好 embedding-base-url 与 embedding-api-key。
  rag:
    enabled: false
        # 阿里云百炼 OpenAI 兼容地址：把 <WorkspaceId> 换成
        # 控制台 → 业务空间管理 → API Host 列的第一段（形如 llm-xxxx / ws-xxxx）
    embedding-base-url: https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
        # 百炼 API Key：控制台 → API 管理 → API Key；本文件会进 Git，绝不可填真实密钥
    embedding-api-key: ""
        # 需单批上限 ≥ 16 条的模型（qwen3.7-text-embedding 支持 20 条 / 1536 维）
    embedding-model: qwen3.7-text-embedding
        # 必须与 Milvus collection 维度一致，否则启动即拒绝
    embedding-dimension: 1536
        # IDEA 中的后端通过宿主机端口访问 Milvus（19530 是 gRPC 端口）
    milvus-uri: http://127.0.0.1:19530
        # 换模型或换维度必须换 collection 名（向量空间不通用）
    collection: knowledge_qwen37_1536
    top-k: 3
    min-score: 0.5
  auth:
    sms:
      provider: mock
      expose-debug-code: true
    jwt:
      merchant-staff-secret-base64: REPLACE_WITH_MERCHANT_STAFF_BASE64_KEY
      consumer-secret-base64: REPLACE_WITH_CONSUMER_BASE64_KEY
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: 127.0.0.1
    port: 3307
    database: gba_dev
    username: dev_admin
    password: REPLACE_WITH_LOCAL_DATABASE_PASSWORD
  redis:
    host: 127.0.0.1
    port: 6380
    database: 0
  websocket:
    enabled: false
  shipment:
    webservice:
      # SOAP WebService 服务间凭证（课程演示；与仓库根 .env 的 SHIPMENT_WS_TOKEN 对应）。
      service-token: ${SHIPMENT_WS_TOKEN:}
  alioss:
    endpoint: https://oss-cn-shenzhen.aliyuncs.com
    access-key-id: local-unused
    access-key-secret: local-unused
    bucket-name: local-unused
  wechat:
    appid: local-unused
    secret: local-unused
  shop:
    address: 广州
  baidu:
    ak: local-unused
  openapi:
    enabled: true
