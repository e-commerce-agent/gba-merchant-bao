# 应用标题
VITE_APP_TITLE=粤港澳商户宝

# 请求前缀：后端接口统一 /api/v1/**
VITE_API_BASE_URL=/api

# 后端地址，dev server 用它做 /api 代理，避免 CORS
VITE_PROXY_TARGET=http://localhost:8080

# 是否使用本地 Mock。后端接口就绪后改成 false 即可切到真实接口
VITE_USE_MOCK=true

# 默认店铺编码。同时用作两个地方：
# 1. 公开商城按 merchantCode 解析租户
# 2. auth-v1 契约里消费者登录路径的 {storeSlug} 路径参数（暂按等于商户编码处理，待后端确认）
VITE_DEFAULT_MERCHANT_CODE=M_3C_DEMO
