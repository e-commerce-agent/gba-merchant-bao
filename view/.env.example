# 复制为 .env.local（本机覆盖，已被 .gitignore 忽略）后按需修改
# 说明：本文件只列变量名与安全默认值，不写入任何账号、密钥或内网地址

# 应用标题
VITE_APP_TITLE=粤港澳商户宝

# 请求前缀：后端接口统一 /api/v1/**
VITE_API_BASE_URL=/api

# 后端地址，dev server 用它做 /api 代理，避免 CORS
VITE_PROXY_TARGET=http://localhost:8080

# 是否使用本地 Mock：true = 前端自带假数据（后端未起也能演示）；false = 走真实接口
VITE_USE_MOCK=true

# 默认店铺编码：公开商城按它解析租户；消费者登录路径的 {storeSlug} 暂按等于商户编码处理
VITE_DEFAULT_MERCHANT_CODE=M_3C_DEMO
